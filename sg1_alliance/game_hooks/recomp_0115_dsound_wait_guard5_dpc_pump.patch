--- a/recomp_0115.c
+++ b/recomp_0115.c
@@ -7988,6 +7988,13 @@
     /* SG1: DirectSound wait-for-voice loop. If the flag is never cleared (the APU never answers), give up
      * after ~2M polls instead of freezing the game; log the object so the cause can be found. */
     ++_sg1_spin;
+    if ((_sg1_spin % 2000u) == 0u) {   /* SG1: a thread waiting at PASSIVE is interrupted by DPCs on a console; run whatever is queued from here */
+        extern int xbox_DispatchGateTryEnter(void); extern void xbox_DispatchGateLeave(void); extern int xbox_DpcDrainHere(void); extern int xbox_IrqlThisThreadBlocksDpcs(void);
+        if (!xbox_IrqlThisThreadBlocksDpcs() && xbox_DispatchGateTryEnter()) {   /* never at raised IRQL: a DPC would wait on the lock this thread holds */
+            int _r = xbox_DpcDrainHere(); xbox_DispatchGateLeave();
+            if (_r) { static int _sg1_pump; if (_sg1_pump++ < 30) { fprintf(stderr, "[SG1] DSound wait spin: ran %d queued DPC(s) while waiting on obj=%08X\n", _r, esi); fflush(stderr); } }
+        }
+    }
     if (_sg1_spin == 1000u || _sg1_spin == 1000000u) {
         fprintf(stderr, "[SG1] DSound wait spin n=%u obj=%08X flags=%04X t78=%08X t7c=%08X\n", _sg1_spin, esi,
                 (unsigned)MEM16(esi + 0x12), MEM32(esi + 0x78), MEM32(esi + 0x7C)); fflush(stderr);
@@ -8002,7 +8009,9 @@
          * only clearing the flag, which left the voice half alive and later corrupted the audio object list. */
         fprintf(stderr, "[SG1] DSound wait spin: running the voice timeout path on obj=%08X (flags=%04X)\n", esi, (unsigned)MEM16(esi + 0x12)); fflush(stderr);
         { extern volatile uint32_t g_sg1_isr_n, g_sg1_dpc_n, g_sg1_ists_or; static int _sg1_dump;   /* SG1 audio probe */
-          fprintf(stderr, "[SG1-AUD] isr=%u dpc=%u ists_or=%08X\n", g_sg1_isr_n, g_sg1_dpc_n, g_sg1_ists_or);
+          { extern int xbox_DpcPending(void); extern unsigned long xbox_DispatchGateOwner(void); uint32_t _c = MEM32(esi + 8);
+            fprintf(stderr, "[SG1-AUD] isr=%u dpc=%u ists_or=%08X dpc_queued_in_host=%d gate_owner=%lu ctx=%08X pending_mask=%08X kdpc_inserted=%u\n", g_sg1_isr_n, g_sg1_dpc_n, g_sg1_ists_or,
+                    xbox_DpcPending(), xbox_DispatchGateOwner(), _c, (_c > 0x10000u && _c < 0x7F000000u) ? MEM32(_c + 0x4B8) : 0u, (_c > 0x10000u && _c < 0x7F000000u) ? (unsigned)MEM8(_c + 0x4CA) : 0u); }
           if (_sg1_dump++ < 8) { int _i; fprintf(stderr, "[SG1-AUD] obj %08X:", esi); for (_i = 0; _i < 36; _i++) fprintf(stderr, " %08X", MEM32(esi + _i * 4));
             fprintf(stderr, "\n[SG1-AUD] obj->+8 %08X:", MEM32(esi + 8)); if (MEM32(esi + 8) > 0x10000u && MEM32(esi + 8) < 0x7F000000u) for (_i = 0; _i < 16; _i++) fprintf(stderr, " %08X", MEM32(MEM32(esi + 8) + _i * 4));
             fprintf(stderr, "\n"); fflush(stderr); } }
